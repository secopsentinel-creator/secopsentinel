# Copiar a .env y ajustar valores. NUNCA versionar .env ni secretos.
# Base de datos (usuario dedicado; no usar root en la aplicación)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/opt/lampp/var/mysql/mysql.sock
DB_NAME=secopsentinel
DB_USER=secopsentinel_app
DB_PASSWORD=cambiar_esta_contrasena
# Solo para Alembic; no la usa la aplicación en ejecución.
DB_MIGRATION_USER=secopsentinel_migrate
DB_MIGRATION_PASSWORD=cambiar_esta_contrasena_de_migracion

# Aplicación
# En producción el archivo real debe residir en ~/.config/secopsentinel/.env
# dentro del volumen cifrado LUKS, con permisos 600.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=cambiar_clave_secreta_aleatoria

# Sesión y autenticación
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=28800
CSRF_COOKIE_NAME=csrf
COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rutas dentro del contenedor LUKS montado en ~/.local/share/secopsentinel
DATA_DIR=~/.local/share/secopsentinel
CASES_DIR=~/.local/share/secopsentinel/cases
QUARANTINE_DIR=~/.local/share/secopsentinel/quarantine

# Servicios locales
OLLAMA_BASE_URL=http://127.0.0.1:11434
